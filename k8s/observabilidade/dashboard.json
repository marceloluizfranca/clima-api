        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "minVizHeight": 16,
        "maxVizHeight": 28
      },
      "description": "Contagem desde o último deploy (os contadores zeram quando os pods são recriados)."
