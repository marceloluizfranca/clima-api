      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"clima\", deployment=\"clima-api\"})",
          "legendFormat": "",
          "refId": "A"
